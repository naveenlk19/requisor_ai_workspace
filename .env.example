# Requisor Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# See runlocal.md for the minimal set needed to boot locally.

# =============================================================================
# CORE (required to boot)
# =============================================================================
NODE_ENV=development
PORT=8080

# Public base URL of this deployment
# Local: http://localhost:8080 | Staging: https://<staging>.onrender.com | Prod: https://requisor.io
APP_URL=http://localhost:8080
APP_DOMAIN=http://localhost:8080
APP_PROTOCOL=http

# PostgreSQL (pgvector extension required: CREATE EXTENSION IF NOT EXISTS vector;)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/requisor

# Session cookie signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# =============================================================================
# AUTH — Google sign-in (required for login)
# Google Cloud Console → Credentials → OAuth client (Web application)
# Authorized redirect URI: <APP_URL>/api/callback
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional GitHub sign-in (callback: <APP_URL>/api/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# OBJECT STORAGE — S3-compatible (AWS S3, Cloudflare R2, or local MinIO)
# Local dev via MinIO: S3_ENDPOINT=http://localhost:9000 (see runlocal.md)
# R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS S3: leave S3_ENDPOINT unset
# =============================================================================
S3_BUCKET=requisor-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_PREFIX=

# =============================================================================
# AI SERVICES
# =============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Diarized transcription for >25MB audio (falls back to Whisper without it)
ASSEMBLYAI_API_KEY=
# Retrieval reranking (optional)
COHERE_API_KEY=
# Hard-document parsing fallback (optional)
UNSTRUCTURED_API_KEY=

# =============================================================================
# PAYMENTS — Stripe (test keys locally/staging, live keys in prod only)
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLIC_KEY=

# =============================================================================
# EMAIL
# =============================================================================
BREVO_API_KEY=
BREVO_FROM_EMAIL=team@requisor.io
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=team@requisor.io

# =============================================================================
# INTEGRATIONS (all optional — features degrade gracefully when unset)
# Each OAuth app must list this deployment's callback URL.
# =============================================================================
# Gmail import (dedicated OAuth client, scope gmail.readonly)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Zoom / Microsoft Teams meeting transcripts
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Slack / Discord conversation import
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_TOKEN_KEY=
# Social publishing
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
MASTODON_ENCRYPTION_KEY=
# Project-management sync
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
SMARTSHEET_CLIENT_ID=
SMARTSHEET_CLIENT_SECRET=
# Linear (personal API key from linear.app → Settings → API)
LINEAR_API_KEY=

# =============================================================================
# BACKGROUND JOBS
# =============================================================================
# Set false on staging to avoid burning tokens on nightly belief consolidation
CRON_ENABLED=true
BELIEF_CONSOLIDATION_HOUR_UTC=9
BELIEF_CONSOLIDATION_MAX_TOKENS_PER_USER=50000

# =============================================================================
# SEEDING (optional)
# =============================================================================
# Demo account (partner@yc.com) is only created/synced when this is set
SEED_DEMO_PASSWORD=
# Comma-separated emails to bump to the Pro plan on boot
SEED_PRO_PLAN_EMAILS=

# =============================================================================
# OBSERVABILITY (optional)
# =============================================================================
# Server-side error tracking. Unset = Sentry fully disabled.
# PII is stripped in server/instrument.ts — keep it that way.
SENTRY_DSN=
# Defaults to NODE_ENV; set explicitly to separate staging from prod
SENTRY_ENVIRONMENT=

# =============================================================================
# MISC
# =============================================================================
ADMIN_TOKEN=
SECRET_KEY=
